# Non-secret production selectors only. Enter actual values in SSM, never here.
HRM_ENVIRONMENT=prod
HRM_SECRET_SOURCE=ssm
HRM_SSM_PARAMETER_PREFIX=/human-resilience-map/prod
HRM_SSM_REGION=us-west-2
HRM_AUTH_MODE=cognito
HRM_COGNITO_REGION=us-west-2
HRM_COGNITO_USER_POOL_ID=REPLACE
HRM_COGNITO_CLIENT_ID=REPLACE
HRM_COGNITO_DOMAIN=https://REPLACE.auth.us-west-2.amazoncognito.com
HRM_PUBLIC_BASE_URL=https://REPLACE
HRM_DB_HOST=REPLACE
HRM_DB_NAME=resilience
HRM_DB_USER=resilience
HRM_DB_SSLMODE=require
HRM_LLM_PROVIDER=openai
HRM_OPENAI_MODEL=gpt-5.4-mini
HRM_OPENAI_REASONING_EFFORT=none
