# Copy to .env for local development. Placeholders only; never commit real secrets.
HRM_ENVIRONMENT=local
HRM_LOG_LEVEL=INFO
HRM_SECRET_SOURCE=environment
HRM_SESSION_SECRET=
# Generate each new secret locally: python3 -c "import secrets; print(secrets.token_urlsafe(48))"

# Database (docker compose db service)
HRM_DB_HOST=localhost
HRM_DB_PORT=5432
HRM_DB_NAME=resilience
HRM_DB_USER=resilience
HRM_DB_PASSWORD=
# For an existing DB, use its current password. For a new DB, generate a strong password.

# Services
HRM_API_BASE_URL=http://localhost:8000

# Auth: "local" trusts a dev user (local ONLY); "cognito" validates JWTs (required in staging/prod)
HRM_AUTH_MODE=local
HRM_LOCAL_DEV_USER=dev-user

# AI models: OpenAI is the app default; stub is an explicit offline/test option only.
HRM_LLM_PROVIDER=openai
OPENAI_API_KEY=
HRM_OPENAI_MODEL=gpt-5.4-mini
HRM_OPENAI_REASONING_EFFORT=none
HRM_LLM_TIMEOUT_SECONDS=60
# bedrock remains supported with AWS credentials and a model ID.
# HRM_BEDROCK_MODEL_ID=
# HRM_BEDROCK_REGION=us-east-1

# Queue/object store: local adapters by default
HRM_QUEUE_BACKEND=local
HRM_OBJECT_STORE_BACKEND=local
HRM_OBJECT_STORE_PATH=./.data/objects

# Bounded sequential analysis roles (safe defaults for local/small-host use)
HRM_MAX_COMPARISON_SCENARIOS=5
HRM_MAX_SENSITIVITY_RUNS=5
HRM_MAX_ANALYSIS_RUNS_PER_JOB=10
HRM_SOLVER_TOTAL_SECONDS_PER_JOB=90
HRM_MAX_TOOL_CALLS_PER_JOB=24
HRM_MAX_RESULT_BYTES=1000000
HRM_SOURCE_FRESHNESS_DAYS=730
HRM_INVENTORY_FRESHNESS_DAYS=365
HRM_ROAD_FRESHNESS_DAYS=365

# Selected-region source preparation (disabled unless explicitly enabled).
HRM_ENABLE_PREPARATION=false
HRM_PREPARATION_PATH=./.data/preparation
# HRM_CENSUS_API_KEY=your Census API key (server-side only)

# After Terraform creates parameters and you enter their real values in AWS:
# HRM_SECRET_SOURCE=ssm
# HRM_SSM_PARAMETER_PREFIX=/human-resilience-map/local
# HRM_SSM_REGION=us-west-2
# HRM_RUNTIME_ROLE=api  # auto-selected by the Docker entrypoint / hrm CLI
# SSM mode ignores .env API keys, database URLs/passwords and session secrets.
# Authenticate with an AWS runtime role or your local AWS profile; do not commit AWS keys.
